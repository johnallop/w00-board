---
/**
 * Sceau WOODDYVIAT, porté en Astro depuis src/components/logo.tsx du dépôt wooddyviat-site
 * (source de la DA, docs/charte.md) : même géométrie, ne pas la modifier ici.
 * Le nom en arc est en Montserrat 700 (public/fonts/montserrat-700.woff2).
 */
interface Props {
  /** Préfixe des identifiants des dégradés et du filtre, unique dans la page. */
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
const g = `url(#${id}g)`;
const a = `url(#${id}a)`;
---

<svg viewBox="-2 -1.5 68 68" class={className} aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}g`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#497783"></stop>
      <stop offset=".55" stop-color="#0F4C5C"></stop>
      <stop offset="1" stop-color="#0b3742"></stop>
    </linearGradient>
    <linearGradient id={`${id}a`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e2ba6f"></stop>
      <stop offset=".55" stop-color="#D9A441"></stop>
      <stop offset="1" stop-color="#9c762f"></stop>
    </linearGradient>
    <filter id={`${id}f`} x="-15%" y="-15%" width="130%" height="135%">
      <feDropShadow dx="0" dy="1.1" stdDeviation="1.1" flood-color="#000" flood-opacity="0.28"></feDropShadow>
    </filter>
    <path id={`${id}t`} d="M8.4 32 A23.6 23.6 0 0 1 55.6 32"></path>
  </defs>
  <g filter={`url(#${id}f)`}>
    <circle cx="32" cy="32" r="31.8" fill="#FFFFFF"></circle>
    <circle cx="32" cy="32" r="30.6" fill="none" stroke={g} stroke-width="2.4"></circle>
    <circle cx="32" cy="32" r="20.6" fill={g}></circle>
    <circle cx="32" cy="32" r="18.7" fill="none" stroke={a} stroke-width=".8"></circle>
    <text
      style="font-family: 'Montserrat', Arial, sans-serif"
      font-weight="700"
      font-size="5.6"
      letter-spacing="1.25"
      fill={g}
      text-anchor="middle"
    >
      <textPath href={`#${id}t`} startOffset="50%">WOODDYVIAT</textPath>
    </text>
    <rect x="5.4" y="30.5" width="3" height="3" fill={a} transform="rotate(45 6.9 32)"></rect>
    <rect x="55.6" y="30.5" width="3" height="3" fill={a} transform="rotate(45 57.1 32)"></rect>
    <path
      d="M46.57 52.81 A25.4 25.4 0 0 1 34.66 57.26 M29.34 57.26 A25.4 25.4 0 0 1 17.43 52.81"
      fill="none"
      stroke={g}
      stroke-width=".8"
      stroke-linecap="round"
    ></path>
    <rect x="30.6" y="56" width="2.8" height="2.8" fill={a} transform="rotate(45 32 57.4)"></rect>
    <g transform="translate(12.8 14) scale(0.6)">
      <polygon fill="#FFFFFF" points="12,18 20,18 26,36 32,22 38,36 44,18 52,18 42,48 35,48 32,40 29,48 22,48"
      ></polygon>
      <path fill={a} d="M11 9.5 Q22 6.5 32 16.5 Q22 12.2 11 9.5Z M53 9.5 Q42 6.5 32 16.5 Q42 12.2 53 9.5Z"></path>
      <circle cx="26.6" cy="23.6" r="2.9" fill={a}></circle>
      <circle cx="37.4" cy="23.6" r="2.9" fill={a}></circle>
      <rect x="22" y="52" width="20" height="3" rx="1.5" fill={a}></rect>
    </g>
  </g>
</svg>
